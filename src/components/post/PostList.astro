---
import EmptySvg from '@components/svg/EmptySvg';
import { defaultCoverList } from '@constants/site-config';
import { getSortedPosts } from '@lib/content';
import type { Page } from 'astro';
import type { BlogPost } from 'types/blog';
import Paginator from './Paginator.astro';
import PostItemCard from './PostItemCard.astro';

interface Props {
  posts?: BlogPost[];
  page?: Page<BlogPost>;
  showPaginator?: boolean;
  baseUrl?: string; // 分页基础路径
  isHomePage?: boolean; // 是否是首页
  isSimple?: boolean; // 是否隐藏封面
}

const { posts, page, showPaginator = true, baseUrl, isHomePage = false, isSimple = false } = Astro.props;
// Use the complete collection so fallback covers remain consistent in filtered lists.
// Published posts pin their chosen artwork in frontmatter.
const allPosts = await getSortedPosts();
const coverById = new Map(allPosts.map((post, index) => [post.id, defaultCoverList[index % defaultCoverList.length]]));
function getCover(post: BlogPost) {
  return coverById.get(post.id) ?? defaultCoverList[0];
}
---

{
  !posts?.length && (
    <div class="text-foreground/30 flex flex-col items-center gap-2">
      <EmptySvg className="fill-foreground/20" />
      <span>还没有发表文章哦～</span>
    </div>
  )
}
{
  posts && posts?.length > 0 && (
    <>
      <div class="flex flex-col gap-4">
        {posts.map((post, index) => (
          <PostItemCard
            key={post.id}
            data={post}
            showTags={!isSimple}
            leftClip={index % 2 === 0}
            randomCover={getCover(post)}
            hideCover={isSimple}
            isSimple={isSimple}
          />
        ))}
      </div>
      {showPaginator && page && <Paginator page={page} baseUrl={baseUrl} isHomePage={isHomePage} />}
    </>
  )
}
