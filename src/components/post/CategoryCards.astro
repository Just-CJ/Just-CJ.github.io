---
import { siteConfig } from '@constants/site-config';
import { getAllTags, getCategoryByLink, getCategoryList, getSortedPosts } from '@lib/content';
import { Icon } from 'astro-icon/components';

// Prefer configured categories that actually exist; older blogs may only use tags.
const { categories } = await getCategoryList();
const configured = (siteConfig.featuredCategories ?? [])
  .filter((category) => getCategoryByLink(categories, category.link))
  .map((category) => ({ label: category.label, href: `/categories/${category.link}` }));
const tags = getAllTags(await getSortedPosts());
const topics = configured.length
  ? configured
  : Object.entries(tags)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 4)
      .map(([tag]) => ({
        label: tag,
        href: `/tags/${tag.toLowerCase().replace(/\//g, '-')}`,
      }));
---

<div class="journal-category-grid">
  {topics.map((topic, index) => (
    <a href={topic.href} class="journal-category-card">
      <span class="journal-topic-index">{String(index + 1).padStart(2, '0')} / TOPIC</span>
      <div><h3>{topic.label}</h3><Icon name="ri:arrow-right-line" /></div>
    </a>
  ))}
</div>
